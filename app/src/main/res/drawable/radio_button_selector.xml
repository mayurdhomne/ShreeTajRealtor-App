<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Selected state -->
    <item android:state_checked="true">
        <layer-list>
            <!-- Outer circle -->
            <item>
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <stroke android:width="2dp" android:color="@color/gradient_end" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
            <!-- Inner filled circle -->
            <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
                <shape android:shape="oval">
                    <solid android:color="@color/gradient_end" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Unselected state -->
    <item android:state_checked="false">
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <stroke android:width="2dp" android:color="@color/light_gray" />
            <solid android:color="@color/light_gray" />
        </shape>
    </item>
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <stroke android:width="2dp" android:color="@color/gradient_start" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    
</selector>