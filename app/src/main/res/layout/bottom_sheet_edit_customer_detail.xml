<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Bottom Sheet Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_sheet_handle"
        android:alpha="0.4" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:background="@color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Customer Detail"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cancel"
            android:contentDescription="Close"
            app:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Basic Fields (Always visible) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Customer Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Customer Name"
                    android:inputType="textPersonName"
                    android:textColor="@android:color/black" android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mobile Number -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mobile Number"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:textColor="@android:color/black" android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Feedback -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Feedback"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Extended Fields (Site Visit & Booking) -->
            <LinearLayout
                android:id="@+id/layoutExtendedFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extended Details"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Plot Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPlotNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Plot Number"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Customer Response -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Response"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgCustomerResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbInterested"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interested"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbNotInterested"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not Interested"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </RadioGroup>

                <!-- Reason Not Interested -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutReasonNotInterested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReasonNotInterested"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Reason Not Interested"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Other Reason -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOtherReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Other Reason/Comments"
                        android:inputType="textMultiLine"
                        android:minLines="2" android:textColor="@android:color/black" android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Status Checkboxes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/cbSiteVisit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Site Visit"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cbMeeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Meeting"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/cbBooking"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Booking"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Next Followup Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNextFollowupDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Next Followup Date"
                        android:focusable="false"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:inputType="none"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Booking Fields (Booking Closed only) -->
            <LinearLayout
                android:id="@+id/layoutBookingFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Details"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Area -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Area (sq.ft)"
                        android:inputType="numberDecimal"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Rate -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Rate"
                        android:inputType="numberDecimal"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Total Value -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTotalValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Total Value"
                        android:inputType="numberDecimal"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TCM -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTcm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="TCM"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Value Per Sqft -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/CustomTextInputLayoutStyle"
                app:boxStrokeColor="@color/button_color"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etValuePerSqft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Value Per Sqft"
                        android:inputType="numberDecimal"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:background="@color/white"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:textColor="@color/button_color"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="@color/button_color"
            app:strokeWidth="2dp"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/white"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="SAVE CHANGES"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/button_color"
            app:cornerRadius="8dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>




