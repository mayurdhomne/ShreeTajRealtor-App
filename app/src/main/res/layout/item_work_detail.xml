<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardWorkDetail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row with Plan Type and Update Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Work Plan Title -->
                <TextView
                    android:id="@+id/tvWorkPlanTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Work Plan Title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Daily Marketing Tasks" />

                <!-- Plan Type -->
                <TextView
                    android:id="@+id/tvPlanType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Plan"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:alpha="0.8"
                    android:layout_marginTop="2dp"
                    tools:text="Daily Plan" />

            </LinearLayout>

            <!-- Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Update"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/gradient_end"
                app:cornerRadius="7dp"
                android:paddingHorizontal="16dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="16dp"
                app:iconTint="@color/white"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            tools:text="Client Calls" />

        <!-- Quantities Row -->

        <!-- Status and Updated At Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Progress"
                android:textSize="12sp"
                android:layout_marginEnd="16dp"
                app:chipMinHeight="32dp"
                tools:text="In Progress" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Updated At -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Updated"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvUpdatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nov 15, 2023"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Nov 15, 2023" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>