<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFC"
    tools:context=".DailyReportActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:navigationIcon="@drawable/ic_back"
            app:title="Daily Report"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Progress Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvStepTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Work Status"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1 of 3"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="33"
                        android:progressTint="@color/button_color" />

                    <!-- Date Time and Location Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tvCurrentDateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Report for: Nov 04, 2025 - 14:30"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:drawableStart="@drawable/ic_calendar"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            app:drawableTint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvLocationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location: Capturing..."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:drawableStart="@drawable/ic_location"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            app:drawableTint="@color/text_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Step 1: Work Status -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Did you complete your work today?"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Yes Option Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardYes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="@color/white"
                                app:strokeColor="@color/text_secondary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="16dp"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:id="@+id/iconYes"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="16dp"
                                        android:src="@drawable/ic_check_circle"
                                        app:tint="@color/success_green" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Yes, work done"
                                        android:textColor="@color/text_primary"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/checkYes"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_radio_selected"
                                        android:visibility="gone"
                                        app:tint="@color/primary_burgundy" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- No Option Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardNo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="@color/white"
                                app:strokeColor="@color/text_secondary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="16dp"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:id="@+id/iconNo"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginEnd="16dp"
                                        android:src="@drawable/ic_cancel"
                                        app:tint="@color/error_red" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="No, work not done"
                                        android:textColor="@color/text_primary"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/checkNo"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_radio_selected"
                                        android:visibility="gone"
                                        app:tint="@color/primary_burgundy" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutReasonNotDone"
                            style="@style/CustomTextInputLayoutStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReasonNotDone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Reason for not completing work"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textMultiLine"
                                android:minLines="2"
                                android:maxLines="4" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Step 2: Work Type Selection -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="What type of work did you do?"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select the work type:"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginBottom="16dp" />

                        <!-- Work Type RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewWorkTypes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Step 3: Customer Details Form (Dynamic based on work type) -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer Details"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- Basic Fields (All Work Types) -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomTextInputLayoutStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCustomerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Customer Name"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textPersonName" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomTextInputLayoutStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMobileNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Mobile Number"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="phone"
                                android:maxLength="15" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilProjectName"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Project Name"
                            android:minHeight="56dp"
                            app:boxBackgroundColor="@color/white"
                            app:boxStrokeColor="@color/gradient_end"
                            app:hintTextColor="@color/text_primary"
                            app:placeholderTextColor="@color/text_secondary"
                            app:endIconMode="dropdown_menu"
                            app:endIconTint="@color/gradient_end">

                            <AutoCompleteTextView
                                android:id="@+id/spinnerProjectName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="none"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:hint="Select Project"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"
                                android:completionThreshold="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Extended Fields Container (For Site Visit & Booking Closed) -->
                        <LinearLayout
                            android:id="@+id/layoutExtendedFields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPlotNumber"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Plot Number"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="text" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customer Response"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp" />

                            <!-- Customer Response Cards -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardInterested"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?android:attr/selectableItemBackground"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white"
                                    app:strokeColor="@color/text_secondary"
                                    app:strokeWidth="1dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:padding="12dp"
                                        android:gravity="center_vertical">

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Interested"
                                            android:textColor="@color/text_primary"
                                            android:textSize="14sp" />

                                        <ImageView
                                            android:id="@+id/checkInterested"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_radio_selected"
                                            android:visibility="gone"
                                            app:tint="@color/primary_burgundy" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardNotInterested"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?android:attr/selectableItemBackground"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white"
                                    app:strokeColor="@color/text_secondary"
                                    app:strokeWidth="1dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:padding="12dp"
                                        android:gravity="center_vertical">

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Not Interested"
                                            android:textColor="@color/text_primary"
                                            android:textSize="14sp" />

                                        <ImageView
                                            android:id="@+id/checkNotInterested"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_radio_selected"
                                            android:visibility="gone"
                                            app:tint="@color/primary_burgundy" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardNotSure"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?android:attr/selectableItemBackground"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="2dp"
                                    app:cardBackgroundColor="@color/white"
                                    app:strokeColor="@color/text_secondary"
                                    app:strokeWidth="1dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:padding="12dp"
                                        android:gravity="center_vertical">

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Not Sure"
                                            android:textColor="@color/text_primary"
                                            android:textSize="14sp" />

                                        <ImageView
                                            android:id="@+id/checkNotSure"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_radio_selected"
                                            android:visibility="gone"
                                            app:tint="@color/primary_burgundy" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutReasonNotInterested"
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:visibility="gone">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etReasonNotInterested"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Reason for not being interested"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="textMultiLine"
                                    android:minLines="2" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutOtherReason"
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:visibility="gone">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etOtherReason"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Other Reason"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="textMultiLine"
                                    android:minLines="2" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Checkboxes -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <CheckBox
                                    android:id="@+id/checkBoxSiteVisit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Site Visit Done"
                                    android:textColor="@color/text_primary"
                                    android:buttonTint="@color/button_color" />

                                <CheckBox
                                    android:id="@+id/checkBoxMeeting"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Meeting Done"
                                    android:textColor="@color/text_primary"
                                    android:buttonTint="@color/button_color" />

                                <CheckBox
                                    android:id="@+id/checkBoxBooking"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Booking Done"
                                    android:textColor="@color/text_primary"
                                    android:buttonTint="@color/button_color" />

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etNextFollowupDate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Next Followup Date"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:clickable="true" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <!-- Booking Closed Specific Fields -->
                        <LinearLayout
                            android:id="@+id/layoutBookingFields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etArea"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Area (sq ft)"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="numberDecimal" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etValuePerSqft"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Value per Sqft"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="number" />

                            </com.google.android.material.textfield.TextInputLayout>
                            
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTotalValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Total Value"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="number" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/CustomTextInputLayoutStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTcm"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="TCM (Total Commission Margin)"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:inputType="number" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <!-- Feedback Field (All Work Types) -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomTextInputLayoutStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFeedback"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Feedback"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textMultiLine"
                                android:minLines="2"
                                android:maxLines="4" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar - positioned above BottomNavigationView -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Add More Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMore"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Add More"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/button_color"
                android:visibility="gone"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/button_color"
                app:strokeWidth="2dp"
                app:cornerRadius="12dp" />

            <!-- Next/Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Next"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_color"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Navigation - Fixed for edge-to-edge and gesture navigation compatibility -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_nav_background"
        android:elevation="@dimen/bottom_nav_elevation"
        android:minHeight="@dimen/bottom_nav_height"
        android:paddingBottom="0dp"
        app:itemIconSize="@dimen/bottom_nav_icon_size"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:itemRippleColor="@color/primary_burgundy" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
